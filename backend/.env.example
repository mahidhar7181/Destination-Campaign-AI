# DestinationCampaign AI Environment Configuration

# Flask and JWT signing secret; set a unique random value in backend/.env
SECRET_KEY=

# AI Engine Mode: auto | pollinations | huggingface | demo
AI_ENGINE_MODE=auto

# Optional Hugging Face Access Token (for Hugging Face Diffusion Inference)
# Get a free token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HF_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Server settings
PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=True
